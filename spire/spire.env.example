# Copy to .env and fill in. The .env file is gitignored.
#
# This file is read by spire/up.sh, spire/down.sh, and bootstrap/setup-akeyless.sh.

# Akeyless API gateway the workload calls to exchange its SVID for a token and
# fetch the secret. Use your account's gateway URL, e.g.
#   https://your-account.akeyless.cloud/api/v2
AKEYLESS_GATEWAY=https://your-account.akeyless.cloud/api/v2

# Auth method access id (p-...) of the OAuth2/JWT auth method. Auto-populated
# into .env by bootstrap/setup-akeyless.sh; the app needs it for `akeyless auth`.
AKEYLESS_ACCESS_ID=

# Short-lived Akeyless temp token (starts with t-) for the bootstrap. Mint it
# yourself so no long-lived API key lives in this repo:
#   akeyless auth --access-id <p-...> --access-type access_key \
#     --access-key <key> --gateway-url <gw>
# or via SAML/OIDC. Copy the printed "Token: t-..." value here. It expires on its
# own. Needs the capabilities in "Required Akeyless permissions" in
# runbooks/02-prerequisites.md.
# This is the only supported way to authenticate the bootstrap.
AKEYLESS_TOKEN=

# ---- advanced: leave these as-is for the demo ----
# Everything below has working defaults and you do not need to change any of it
# to run the quick start. Change a value only to customize the demo; see
# runbooks/05-configuration.md for what each one does.

# SPIRE trust domain. The name of the trust "world" the demo runs in. It is a
# made-up label for the demo, not a real internet domain you must own. Every
# identity in the demo is under it. spire/up.sh renders it into the server and
# agent configs, so the trust domain, agent, and workload IDs all derive from it.
SPIFFE_TRUST_DOMAIN=example.org
# Name the demo gives to your app. SPIRE issues the app an identity document
# that proves "I am this workload, in the trust domain above." Leave as-is.
WORKLOAD_SPIFFE_ID=spiffe://example.org/ns/default/sa/secret-consumer
# Who the identity is for. The token is only valid when handed to Akeyless, so a
# stolen one cannot be reused elsewhere. Leave as-is.
JWT_AUDIENCE=akeyless

# SPIRE lifetimes as Go duration strings. Defaults match SPIRE. Override to tune
# the anti-theft window (shorter JWT-SVID) or the rotation cadence.
JWT_SVID_TTL=5m
X509_SVID_TTL=1h
CA_TTL=24h

# Akeyless object paths created by the bootstrap.
AKEYLESS_AUTH_METHOD=/spiffe/demo/auth
AKEYLESS_ROLE=/spiffe/demo/reader
AKEYLESS_SECRET=/spiffe/demo/db-password
