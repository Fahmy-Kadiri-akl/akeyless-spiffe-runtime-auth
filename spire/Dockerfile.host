# "host" container: spire-agent + the Akeyless Secret Manager plugin + the .NET
# reference app, co-located in one container so unix workload attestation works
# with no extra plumbing. The app calls the Akeyless REST API over HTTP.

# --- stage 1: pull the spire-agent binary out of the official image ---
FROM ghcr.io/spiffe/spire-agent:1.15.2 AS spire

# --- stage 2: download the Akeyless Secret Manager plugin ---
FROM alpine:3.19 AS plugins
RUN apk add --no-cache curl && \
    curl -fsSL -o /AkeylessSecretManager \
      https://download.akeyless.io/Akeyless_Artifacts/Linux/spire/plugin/agent/spire-sm-amd64-linux-v0.0.6 && \
    chmod +x /AkeylessSecretManager

# --- stage 3: .NET 8 SDK + app + plugins ---
FROM mcr.microsoft.com/dotnet/sdk:8.0

# spire-agent binary (talks to the Workload API)
COPY --from=spire /opt/spire/bin/spire-agent /usr/local/bin/spire-agent
# Akeyless Secret Manager plugin (stores X.509-SVIDs in Akeyless)
COPY --from=plugins /AkeylessSecretManager /opt/spire/AkeylessSecretManager

WORKDIR /app
COPY app/SecretConsumer.csproj ./
RUN dotnet restore
COPY app/ ./
RUN dotnet build -c Release --no-restore

# Agent config + host entrypoint
COPY spire/agent.conf /opt/spire/conf/agent/agent.conf
COPY spire/host-entrypoint.sh /opt/host-entrypoint.sh
RUN chmod +x /opt/host-entrypoint.sh

ENTRYPOINT ["/opt/host-entrypoint.sh"]
