# "host" container: spire-agent + the .NET reference app + the Go X.509 mTLS
# demo pair, co-located in one container so unix workload attestation works
# with no extra plumbing (mirrors an on-prem host where the agent and workloads
# share a kernel). The app calls the Akeyless REST API over HTTP, so no Akeyless
# CLI is needed.

# --- stage 1: pull the spire-agent binary out of the official image ---
FROM ghcr.io/spiffe/spire-agent:1.15.2 AS spire

# --- stage 2: build the Go X.509 mTLS demo pair (go-spiffe) ---
FROM golang:1.25 AS mtls
WORKDIR /src
COPY mtls/go.mod mtls/go.sum ./
RUN go mod download
COPY mtls/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/server ./server && \
    CGO_ENABLED=0 go build -trimpath -o /out/client ./client

# --- stage 3: .NET 8 SDK + app + the mTLS binaries ---
FROM mcr.microsoft.com/dotnet/sdk:8.0

# spire-agent binary (talks to the Workload API)
COPY --from=spire /opt/spire/bin/spire-agent /usr/local/bin/spire-agent
# X.509 mTLS demo binaries (go-spiffe). run-mtls.sh runs each under a distinct
# UID so SPIRE can attest them as separate workloads.
COPY --from=mtls /out/server /app/mtls/server
COPY --from=mtls /out/client /app/mtls/client
# In-container demo orchestrator (run via mtls/run-mtls.sh on the host).
COPY mtls/demo.sh /app/mtls/demo.sh
RUN chmod +x /app/mtls/demo.sh

WORKDIR /app
COPY app/SecretConsumer.csproj ./
RUN dotnet restore
COPY app/ ./
RUN dotnet build -c Release --no-restore

# Agent config + host entrypoint
COPY spire/agent.conf /opt/spire/conf/agent/agent.conf
COPY spire/host-entrypoint.sh /opt/host-entrypoint.sh
RUN chmod +x /opt/host-entrypoint.sh

ENTRYPOINT ["/opt/host-entrypoint.sh"]
