# SPIRE server with the Akeyless UpstreamAuthority plugin.
# The official SPIRE image does not include the Akeyless plugin; download it.
FROM alpine:3.19 AS downloader
RUN apk add --no-cache curl && \
    curl -fsSL -o /AkeylessUpstreamAuthority \
      https://download.akeyless.io/Akeyless_Artifacts/Linux/spire/plugin/server/spire-upstream/spire-upstream-linux-amd64 && \
    chmod +x /AkeylessUpstreamAuthority

FROM ghcr.io/spiffe/spire-server:1.15.2
COPY --from=downloader /AkeylessUpstreamAuthority /opt/spire/AkeylessUpstreamAuthority
